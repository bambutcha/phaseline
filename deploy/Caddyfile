:80 {
	handle /api/* {
		reverse_proxy api:8080 {
			lb_try_duration 10s
			lb_try_interval 250ms
		}
	}

	handle /ws/* {
		reverse_proxy api:8080 {
			lb_try_duration 10s
			lb_try_interval 250ms
			flush_interval -1
		}
	}

	handle /health {
		reverse_proxy api:8080 {
			lb_try_duration 10s
			lb_try_interval 250ms
		}
	}

	handle /ready {
		reverse_proxy api:8080 {
			lb_try_duration 10s
			lb_try_interval 250ms
		}
	}

	@share path_regexp share ^/s/([A-Za-z0-9-]+)$
	redir @share /?seed={re.share.1} 302

	handle {
		reverse_proxy web:3000
	}
}
